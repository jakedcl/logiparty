# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# NextAuth — generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://nydac.localhost:3000
AUTH_TRUST_HOST=true

# Subdomain tenancy
NEXT_PUBLIC_ROOT_DOMAIN=logiparty.com
# If set, bare localhost acts as this tenant (prefer nydac.localhost /
# test.localhost / axis.localhost instead). Leave unset/empty to preview
# the apex marketing homepage.
# Primary local tenant when using bare localhost:
# NEXT_PUBLIC_DEV_ORG_SLUG=nydac

# Cloudflare R2 (M4+)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# Resend (M1+)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ops@yourdomain.com
# Optional: where marketing lead form emails go (A3)
# LEADS_NOTIFY_EMAIL=you@example.com

# Stripe (M6 scaffold — optional; leave empty until ready; never commit secrets)
# App works without these. Billing UI shows “not configured yet.”
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=                 # recurring Price id (price_…) for Checkout
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # optional; only needed for embedded Checkout later
# Webhook endpoint (apex): https://logiparty.com/api/stripe/webhook

# Optional cron auth for /api/cron/auto-ready
# CRON_SECRET=

# A8 — Dev role / persona switcher (local only). Never set on Vercel Production.
# Hard-denied when VERCEL_ENV=production even if this is true.
# ALLOW_DEV_ROLE_SWITCH=true
