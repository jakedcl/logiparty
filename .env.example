# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# NextAuth — generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://acme.localhost:3000
AUTH_TRUST_HOST=true

# Subdomain tenancy
NEXT_PUBLIC_ROOT_DOMAIN=logiparty.com
# Local dev fallback when host is plain localhost
NEXT_PUBLIC_DEV_ORG_SLUG=acme

# Cloudflare R2 (M4+)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# Resend (M1+)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ops@yourdomain.com
